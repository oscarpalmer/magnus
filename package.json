{
	"name": "@oscarpalmer/magnus",
	"version": "0.31.0",
	"description": "A JavaScript framework for developers who like HTML.",
	"keywords": [
		"framework",
		"frontend",
		"html-first",
		"progressive enhancement",
		"stimulusjs"
	],
	"license": "MIT",
	"author": {
		"name": "Oscar Palmér",
		"url": "https://oscarpalmer.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarpalmer/magnus.git"
	},
	"files": [
		"dist",
		"src",
		"types"
	],
	"type": "module",
	"module": "dist/index.js",
	"types": "types/index.d.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./types/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "vpx vp run tsdown:build && vpx vp pack",
		"tsdown:build": "vpx tsdown -c ./tsdown.config.ts",
		"tsdown:watch": "vpx tsdown -c ./tsdown.config.ts --watch",
		"test": "npx vp test run --coverage",
		"test:leak": "vpx vp test run --detect-async-leaks --coverage"
	},
	"dependencies": {
		"@oscarpalmer/atoms": "^0.204",
		"@oscarpalmer/datum": "^0.11",
		"@oscarpalmer/toretto": "^0.54"
	},
	"devDependencies": {
		"@oscarpalmer/oui": "^0.38",
		"@types/node": "^26.5",
		"@vitest/coverage-istanbul": "^4.1",
		"jsdom": "^30.1",
		"tsdown": "^0.23",
		"typescript": "^6",
		"vite": "npm:@voidzero-dev/vite-plus-core@latest",
		"vite-plus": "latest",
		"vitest": "npm:@voidzero-dev/vite-plus-test@latest"
	}
}
