{
	"name": "@oscarpalmer/magnus",
	"version": "0.32.0",
	"description": "A JavaScript framework for developers who like HTML.",
	"keywords": [
		"framework",
		"frontend",
		"html-first",
		"progressive enhancement",
		"stimulusjs"
	],
	"license": "MIT",
	"author": {
		"name": "Oscar Palmér",
		"url": "https://oscarpalmer.se"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/oscarpalmer/magnus.git"
	},
	"files": [
		"dist",
		"src",
		"types"
	],
	"type": "module",
	"module": "dist/index.mjs",
	"types": "dist/index.d.mts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.mts",
			"default": "./dist/index.mjs"
		}
	},
	"scripts": {
		"build": "vpx vp run tsdown:build && vpx vp pack",
		"tsdown:build": "vpx tsdown -c ./tsdown.config.ts",
		"tsdown:watch": "vpx tsdown -c ./tsdown.config.ts --watch",
		"test": "npx vp test run --coverage",
		"test:leak": "vpx vp test run --detect-async-leaks --coverage"
	},
	"dependencies": {
		"@oscarpalmer/atoms": "^0.221",
		"@oscarpalmer/datum": "^0.12",
		"@oscarpalmer/toretto": "^0.57"
	},
	"devDependencies": {
		"@oscarpalmer/oui": "^0.42",
		"@types/node": "^26.6",
		"@vitest/coverage-istanbul": "^4.1",
		"jsdom": "^30.1",
		"tsdown": "^0.23",
		"typescript": "^7",
		"vite-plus": "^1.4"
	}
}
